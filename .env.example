# LingoSpace Pro — Production Environment
# Copy to .env.local for local development. Never commit .env.local.

# Public production URL (contoh: https://lingospace.example.com)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_MAIN_WEBSITE=

# Gemini AI (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Google Apps Script translator endpoint
TRANSLATE_GAS_URL=

# Firebase Web config (public client configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Optional: comma-separated extra origins allowed to call AI endpoints.
# Same-origin requests are always accepted.
ALLOWED_ORIGINS=

# API rate-limit tuning per server instance/window
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
TRANSLATE_RATE_LIMIT_MAX=30
